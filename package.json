{
  "name": "@nsheaps/cors-proxy",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nsheaps/cors-proxy.git"
  },
  "description": "Cloudflare Worker CORS proxy for GitHub OAuth endpoints — shared auth service for nsheaps apps",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run test",
    "check": "prettier --check '**/*.{yaml,yml,md,json}' '!.github/workflows/**'",
    "check:fix": "prettier --write '**/*.{yaml,yml,md,json}' '!.github/workflows/**'",
    "deploy": "wrangler deploy",
    "release": "release-it",
    "release:ci": "release-it --ci"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260715.1",
    "@release-it/bumper": "^7.0.6",
    "@release-it/conventional-changelog": "^11.0.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "release-it": "^20.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
